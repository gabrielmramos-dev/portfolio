---
import { readingTime, type Post } from '../lib/posts';
import { routes, type Lang } from '../i18n/ui';

interface Props {
  post: Post;
  lang?: Lang;
}

const { post, lang = 'pt' } = Astro.props;
const { title, description, date, tags } = post.data;

function formatDate(date: Date): string {
  return date.toLocaleDateString(lang === 'pt' ? 'pt-BR' : 'en-US', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
}
---

<li class="post-row" data-tags={tags.join('|')}>
  <a href={`${routes.blog[lang]}${post.id}/`}>
    <span class="post-title">{title}</span>
    <span class="post-desc">{description}</span>
    <span class="post-meta">
      <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingTime(post)} min
      {tags.length > 0 && <> · {tags.slice(0, 3).join(', ')}</>}
    </span>
  </a>
</li>
