---
// Comentários usando Giscus (GitHub Discussions)

import type { Lang } from '../i18n/ui';

interface Props {
  lang?: Lang;
  repo?: string;
  repoId?: string;
  category?: string;
  categoryId?: string;
}

const {
  lang = 'pt',
  repo = 'gabrielmramos-dev/blog-discussions',
  repoId = 'R_kgDOQsoNCw',
  category = 'General',
  categoryId = 'DIC_kwDOQsoNC84C0EqR',
} = Astro.props;

const isEnabled = repo && repoId && category && categoryId;
---

{isEnabled && (
  <section class="comments">
    <h2>{lang === 'pt' ? 'Comentários' : 'Comments'}</h2>
    <div
      class="giscus-container"
      data-repo={repo}
      data-repo-id={repoId}
      data-category={category}
      data-category-id={categoryId}
      data-lang={lang}
    ></div>
    <noscript>{lang === 'pt' ? 'Ative o JavaScript para ver e deixar comentários.' : 'Enable JavaScript to read and leave comments.'}</noscript>
  </section>
)}

<script>
  const currentTheme = () => (document.documentElement.dataset.theme === 'light' ? 'light' : 'dark');

  function loadGiscus() {
    const container = document.querySelector('.giscus-container');
    if (!container) return;

    // Limpa instância anterior (iframe e script) antes de recarregar
    container.replaceChildren();

    const script = document.createElement('script');
    script.src = 'https://giscus.app/client.js';
    script.setAttribute('data-repo', container.getAttribute('data-repo') || '');
    script.setAttribute('data-repo-id', container.getAttribute('data-repo-id') || '');
    script.setAttribute('data-category', container.getAttribute('data-category') || '');
    script.setAttribute('data-category-id', container.getAttribute('data-category-id') || '');
    script.setAttribute('data-mapping', 'pathname');
    script.setAttribute('data-strict', '0');
    script.setAttribute('data-reactions-enabled', '1');
    script.setAttribute('data-emit-metadata', '0');
    script.setAttribute('data-input-position', 'bottom');
    script.setAttribute('data-theme', currentTheme());
    script.setAttribute('data-loading', 'lazy');
    script.setAttribute('data-lang', container.getAttribute('data-lang') || 'pt');
    script.setAttribute('crossorigin', 'anonymous');
    script.async = true;

    container.appendChild(script);
  }

  // Dispara na carga inicial e a cada navegação (ClientRouter)
  document.addEventListener('astro:page-load', loadGiscus);

  // Troca o tema do widget sem recarregá-lo.
  document.addEventListener('themechange', () => {
    const frame = document.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
    frame?.contentWindow?.postMessage({ giscus: { setConfig: { theme: currentTheme() } } }, 'https://giscus.app');
  });
</script>
