---
import type { Lang } from '../i18n/ui';

interface Props {
  user?: string;
  lang?: Lang;
  /** Nomes dos repositórios cujos eventos aparecem no feed. */
  repos: string[];
}

const { user = 'gabrielmramos-dev', lang = 'pt', repos } = Astro.props;

const copy = {
  pt: {
    title: 'Atividade no GitHub',
    graphLabel: 'Gráfico de contribuições dos últimos meses',
    less: 'Menos',
    more: 'Mais',
    summary: '{n} contribuições nos últimos 6 meses · {total} no último ano',
    cell: '{n} contribuições em {date}',
    push: 'Push em {branch}',
    branchFallback: 'branch',
    repoCreated: 'Repositório criado',
    branchCreated: 'Branch criado: {branch}',
    pullRequest: 'Pull request',
    locale: 'pt-BR',
  },
  en: {
    title: 'GitHub activity',
    graphLabel: 'Contribution graph for the last months',
    less: 'Less',
    more: 'More',
    summary: '{n} contributions in the last 6 months · {total} in the last year',
    cell: '{n} contributions on {date}',
    push: 'Push to {branch}',
    branchFallback: 'a branch',
    repoCreated: 'Repository created',
    branchCreated: 'Branch created: {branch}',
    pullRequest: 'Pull request',
    locale: 'en',
  },
}[lang];
---

<section
  class="gh-activity"
  aria-labelledby="gh-title"
  data-user={user}
  data-repos={JSON.stringify(repos)}
  data-copy={JSON.stringify(copy)}
  hidden
>
  <div class="gh-header">
    <h2 id="gh-title">{copy.title}</h2>
    <a href={`https://github.com/${user}`} target="_blank" rel="noopener noreferrer" class="section-note">@{user}</a>
  </div>
  <p class="gh-summary" data-summary></p>
  <div class="gh-graph-scroll">
    <div class="gh-graph" data-graph role="img" aria-label={copy.graphLabel}></div>
  </div>
  <div class="gh-legend" aria-hidden="true">
    {copy.less}
    <span class="gh-cell"></span><span class="gh-cell gh-l1"></span><span class="gh-cell gh-l2"></span><span class="gh-cell gh-l3"></span><span class="gh-cell gh-l4"></span>
    {copy.more}
  </div>
  <ul class="gh-events" data-events></ul>
</section>

<script>
  const CACHE_MS = 10 * 60 * 1000;
  const WEEKS = 26;

  async function cached<T>(key: string, url: string): Promise<T> {
    try {
      const hit = sessionStorage.getItem(key);
      if (hit) {
        const { at, data } = JSON.parse(hit);
        if (Date.now() - at < CACHE_MS) return data;
      }
    } catch {}
    const response = await fetch(url);
    if (!response.ok) throw new Error(`${url}: ${response.status}`);
    const data = await response.json();
    try {
      sessionStorage.setItem(key, JSON.stringify({ at: Date.now(), data }));
    } catch {}
    return data;
  }

  type Copy = Record<string, string>;

  const fill = (template: string, values: Record<string, string | number>) =>
    template.replace(/\{(\w+)\}/g, (_, key) => String(values[key]));

  function timeAgo(iso: string, locale: string): string {
    const diff = (Date.now() - new Date(iso).getTime()) / 1000;
    const rtf = new Intl.RelativeTimeFormat(locale, { numeric: 'auto' });
    if (diff < 3600) return rtf.format(-Math.max(1, Math.round(diff / 60)), 'minute');
    if (diff < 86400) return rtf.format(-Math.round(diff / 3600), 'hour');
    return rtf.format(-Math.round(diff / 86400), 'day');
  }

  type Day = { date: string; count: number; level: number };

  function renderGraph(root: HTMLElement, summary: HTMLElement, days: Day[], total: number, copy: Copy) {
    const recent = days.slice(-WEEKS * 7);
    const firstDow = new Date(recent[0].date + 'T00:00:00').getDay();
    const cells: string[] = Array(firstDow).fill('<span class="gh-cell gh-pad"></span>');
    for (const day of recent) {
      cells.push(`<span class="gh-cell gh-l${day.level}" title="${fill(copy.cell, { n: day.count, date: day.date })}"></span>`);
    }
    root.innerHTML = cells.join('');
    const lastMonths = recent.reduce((sum, d) => sum + d.count, 0);
    summary.textContent = fill(copy.summary, { n: lastMonths, total });
  }

  function renderEvents(list: HTMLElement, events: any[], repos: string[], copy: Copy) {
    const items = [...events]
      .sort((a, b) => b.created_at.localeCompare(a.created_at))
      .filter((e) => repos.includes(String(e.repo.name).split('/')[1]))
      .filter((e) => e.type === 'PushEvent' || e.type === 'CreateEvent' || e.type === 'PullRequestEvent')
      .slice(0, 4)
      .map((e) => {
        const repo = String(e.repo.name).split('/')[1];
        const url = `https://github.com/${e.repo.name}`;
        const branch = String(e.payload?.ref ?? '').replace('refs/heads/', '');
        const label =
          e.type === 'PushEvent'
            ? fill(copy.push, { branch: branch || copy.branchFallback })
            : e.type === 'CreateEvent'
              ? e.payload?.ref_type === 'repository' ? copy.repoCreated : fill(copy.branchCreated, { branch })
              : copy.pullRequest;
        const li = document.createElement('li');
        const a = document.createElement('a');
        a.href = url;
        a.target = '_blank';
        a.rel = 'noopener noreferrer';
        const name = document.createElement('strong');
        name.textContent = repo;
        const text = document.createElement('span');
        text.textContent = label;
        const time = document.createElement('time');
        time.dateTime = e.created_at;
        time.textContent = timeAgo(e.created_at, copy.locale);
        a.append(name, text, time);
        li.append(a);
        return li;
      });
    list.replaceChildren(...items);
  }

  async function loadGithub() {
    const section = document.querySelector<HTMLElement>('.gh-activity');
    if (!section) return;
    const user = section.dataset.user!;
    const repos: string[] = JSON.parse(section.dataset.repos ?? '[]');
    const copy: Copy = JSON.parse(section.dataset.copy ?? '{}');
    const graph = section.querySelector<HTMLElement>('[data-graph]')!;
    const summary = section.querySelector<HTMLElement>('[data-summary]')!;
    const list = section.querySelector<HTMLElement>('[data-events]')!;

    const [calendar, events] = await Promise.allSettled([
      cached<any>(`gh-cal-${user}`, `https://github-contributions-api.jogruber.de/v4/${user}?y=last`),
      cached<any[]>(`gh-ev-${user}`, `https://api.github.com/users/${user}/events/public?per_page=100`),
    ]);

    if (calendar.status === 'fulfilled') {
      renderGraph(graph, summary, calendar.value.contributions, calendar.value.total?.lastYear ?? 0, copy);
    } else {
      graph.parentElement!.hidden = true;
    }
    if (events.status === 'fulfilled') renderEvents(list, events.value, repos, copy);

    // Sem nenhum dado, a seção fica escondida.
    section.hidden = calendar.status === 'rejected' && events.status === 'rejected';
  }

  document.addEventListener('astro:page-load', loadGithub);
</script>

<style is:global>
  .gh-activity {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .gh-activity .gh-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
  }

  .gh-activity .gh-summary {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
  }

  .gh-activity .gh-graph-scroll {
    overflow-x: auto;
    padding-bottom: 8px;
  }

  .gh-activity .gh-graph {
    display: grid;
    grid-template-rows: repeat(7, 11px);
    grid-auto-flow: column;
    grid-auto-columns: 11px;
    gap: 3px;
    width: max-content;
  }

  .gh-activity .gh-cell {
    width: 11px;
    height: 11px;
    border-radius: 2px;
    background: var(--border);
  }

  .gh-activity .gh-pad {
    background: none;
  }

  .gh-activity .gh-l1 { background: color-mix(in srgb, var(--link) 30%, var(--bg)); }
  .gh-activity .gh-l2 { background: color-mix(in srgb, var(--link) 55%, var(--bg)); }
  .gh-activity .gh-l3 { background: color-mix(in srgb, var(--link) 80%, var(--bg)); }
  .gh-activity .gh-l4 { background: var(--link); }

  .gh-activity .gh-legend {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--muted);
    font-size: 13px;
  }

  .gh-activity .gh-legend .gh-cell {
    width: 10px;
    height: 10px;
  }

  .gh-activity .gh-events {
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    border-top: 1px solid var(--border-strong);
  }

  .gh-activity .gh-events:empty {
    display: none;
  }

  .gh-activity .gh-events li {
    border-bottom: 1px solid var(--border);
  }

  .gh-activity .gh-events a {
    display: grid;
    grid-template-columns: minmax(0, 11rem) minmax(0, 1fr) auto;
    gap: 12px;
    align-items: baseline;
    padding: 10px 0;
    color: var(--muted);
    font-size: 14px;
    text-decoration: none;
  }

  .gh-activity .gh-events a:hover strong {
    text-decoration: underline;
  }

  .gh-activity .gh-events strong {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
  }

  .gh-activity .gh-events span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gh-activity .gh-events time {
    font-family: var(--font-mono);
    font-size: 12px;
  }

  @media screen and (max-width: 700px) {
    .gh-activity .gh-events a {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .gh-activity .gh-events strong {
      grid-column: 1 / -1;
    }
  }
</style>
