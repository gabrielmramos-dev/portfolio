---
import type { Lang } from '../i18n/ui';
import type { Project } from '../data/projects';
import Sp156Chart from './Sp156Chart.astro';
import ProjectFigure from './ProjectFigure.astro';
import { makeAbbr } from '../lib/abbr';

interface Props {
  project: Project;
  lang?: Lang;
  /** Recebe as siglas usadas, para a lista de termos da página. */
  used?: Set<string>;
}

const { project, lang = 'pt', used } = Astro.props;
const abbr = makeAbbr(lang, used);

const labels = {
  pt: { problem: 'Problema', decisions: 'Decisões técnicas', limits: 'Limites', result: 'Resultado', tech: 'Tecnologias', repo: 'no GitHub', newTab: ' (abre em nova aba)' },
  en: { problem: 'Problem', decisions: 'Technical decisions', limits: 'Limits', result: 'Result', tech: 'Technologies', repo: 'on GitHub', newTab: ' (opens in a new tab)' },
}[lang];

const { title, badge, badgeTone, summary, problem, decisions, limits, result, tech, githubUrl } = project;
---

<article class="case" id={project.id}>
  <div class="case-head">
    <div class="case-title">
      <h2>{title}</h2>
      {badge && <span class:list={['badge', badgeTone === 'ok' && 'badge-ok']}>{badge[lang]}</span>}
    </div>
    <a href={githubUrl} target="_blank" rel="noopener noreferrer">GitHub<span class="sr-only"> — {title} {labels.repo}{labels.newTab}</span></a>
  </div>

  <p class="case-summary" set:html={abbr(summary[lang])} />

  <ProjectFigure project={project} lang={lang} />
  {project.id === 'sp156-mcp' && <Sp156Chart lang={lang} />}

  <section class="case-section">
    <h3>{labels.problem}</h3>
    <p set:html={abbr(problem[lang])} />
  </section>

  <section class="case-section">
    <h3>{labels.decisions}</h3>
    <ul>{decisions[lang].map((item) => <li set:html={abbr(item)} />)}</ul>
  </section>

  <section class="case-section limits">
    <h3>{labels.limits}</h3>
    <ul>{limits[lang].map((item) => <li set:html={abbr(item)} />)}</ul>
  </section>

  <section class="case-section">
    <h3>{labels.result}</h3>
    <p set:html={abbr(result[lang])} />
  </section>

  <p class="case-tech"><strong>{labels.tech}:</strong> {tech.join(', ')}</p>
</article>
