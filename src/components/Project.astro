---
import type { Lang } from '../i18n/ui';
import type { Project } from '../data/projects';

interface Props {
  project: Project;
  lang?: Lang;
}

const { project, lang = 'pt' } = Astro.props;

const labels = {
  pt: { problem: 'Problema', decisions: 'Decisões técnicas', result: 'Resultado', tech: 'Tecnologias & ferramentas', placeholder: 'Screenshot em breve', repo: 'no GitHub' },
  en: { problem: 'Problem', decisions: 'Technical decisions', result: 'Result', tech: 'Technologies & tools', placeholder: 'Screenshot coming soon', repo: 'on GitHub' },
}[lang];

const { title, badge, summary, problem, decisions, result, tech, githubUrl, media } = project;
---

<article class="single-item project-case" id={project.id}>
  <div class="project-header">
    <div class="project-title">
      <h3>{title}</h3>
      {badge && <span class="project-badge">{badge[lang]}</span>}
    </div>
    <a href={githubUrl} target="_blank" rel="noopener noreferrer" class="project-github" aria-label={`${title} ${labels.repo}`}>
      <svg width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
      </svg>
      GitHub
    </a>
  </div>

  <p class="project-summary">{summary[lang]}</p>

  {media.src ? (
    <figure class="project-media">
      <img src={media.src} alt={media.alt[lang]} loading="lazy" decoding="async" />
    </figure>
  ) : (
    <div class="project-media project-media-placeholder" role="img" aria-label={media.alt[lang]}>
      <span aria-hidden="true">{labels.placeholder}</span>
    </div>
  )}

  <div class="mini-label-white">{labels.problem}</div>
  <p class="project-text">{problem[lang]}</p>

  <div class="mini-label-white">{labels.decisions}</div>
  <div class="project-desc project-desc-list w-richtext">
    <ul role="list">
      {decisions[lang].map((item) => <li>{item}</li>)}
    </ul>
  </div>

  <div class="mini-label-white">{labels.result}</div>
  <p class="project-text">{result[lang]}</p>

  <div class="mini-label-white">{labels.tech}</div>
  <div class="chips-container">
    {tech.map((techItem) => <div class="single-chip">{techItem}</div>)}
  </div>
</article>
