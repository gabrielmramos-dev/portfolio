---
import type { Lang } from '../i18n/ui';
import type { Project } from '../data/projects';
import Sp156Chart from './Sp156Chart.astro';
import ProjectFigure from './ProjectFigure.astro';

interface Props {
  project: Project;
  lang?: Lang;
}

const { project, lang = 'pt' } = Astro.props;

const labels = {
  pt: { problem: 'Problema', decisions: 'Decisões técnicas', limits: 'Limites', result: 'Resultado', tech: 'Tecnologias', repo: 'no GitHub' },
  en: { problem: 'Problem', decisions: 'Technical decisions', limits: 'Limits', result: 'Result', tech: 'Technologies', repo: 'on GitHub' },
}[lang];

const { title, badge, badgeTone, summary, problem, decisions, limits, result, tech, githubUrl } = project;
---

<article class="case" id={project.id}>
  <div class="case-head">
    <div class="case-title">
      <h2>{title}</h2>
      {badge && <span class:list={['badge', badgeTone === 'ok' && 'badge-ok']}>{badge[lang]}</span>}
    </div>
    <a href={githubUrl} target="_blank" rel="noopener noreferrer" aria-label={`${title} ${labels.repo}`}>GitHub</a>
  </div>

  <p class="case-summary">{summary[lang]}</p>

  <ProjectFigure project={project} lang={lang} />
  {project.id === 'sp156-mcp' && <Sp156Chart lang={lang} />}

  <section class="case-section">
    <h3>{labels.problem}</h3>
    <p>{problem[lang]}</p>
  </section>

  <section class="case-section">
    <h3>{labels.decisions}</h3>
    <ul>{decisions[lang].map((item) => <li>{item}</li>)}</ul>
  </section>

  <section class="case-section limits">
    <h3>{labels.limits}</h3>
    <ul>{limits[lang].map((item) => <li>{item}</li>)}</ul>
  </section>

  <section class="case-section">
    <h3>{labels.result}</h3>
    <p>{result[lang]}</p>
  </section>

  <p class="case-tech"><strong>{labels.tech}:</strong> {tech.join(', ')}</p>
</article>
