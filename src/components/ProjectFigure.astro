---
import type { Lang } from '../i18n/ui';
import type { Project } from '../data/projects';
import Flow from './Flow.astro';

interface Props {
  project: Project;
  lang: Lang;
}

const { project, lang } = Astro.props;
const { figure } = project;
const placeholder = { pt: 'Screenshot em breve', en: 'Screenshot coming soon' }[lang];
---

{figure.kind === 'flow' && (
  <Flow nodes={figure.nodes} lang={lang} label={figure.alt[lang]} note={figure.note?.[lang]} />
)}

{figure.kind === 'shots' && (
  <figure class="figure shots">
    {figure.shots.map((shot) => (
      <img src={shot.src} alt={shot.alt[lang]} width="420" height="909" loading="lazy" decoding="async" />
    ))}
  </figure>
)}

{figure.kind === 'image' && (
  <figure class="figure">
    <img src={figure.src} alt={figure.alt[lang]} loading="lazy" decoding="async" />
  </figure>
)}

{figure.kind === 'placeholder' && (
  <div class="figure figure-placeholder" role="img" aria-label={figure.alt[lang]}>
    <span aria-hidden="true">{placeholder}</span>
  </div>
)}
