---
import Controls from './Controls.astro';
import { routes, ui, type Lang } from '../i18n/ui';

interface Props {
  selectedItem?: string;
  lang?: Lang;
  alternates?: Partial<Record<Lang, string>>;
}

const { selectedItem, lang = 'pt', alternates } = Astro.props;
const t = ui[lang];

// Formação e Blog só existem em português.
const items = [
  { id: 'projetos', href: routes.projects[lang], label: t.nav.projects },
  { id: 'experiencia', href: routes.experience[lang], label: t.nav.experience },
  { id: 'formacao', href: '/formacao/', label: t.nav.education },
  { id: 'blog', href: '/blog/', label: t.nav.blog },
];
---

<header class="rail" data-rail>
  <a href={routes.home[lang]} class="brand">
    <span class="brand-name">Gabriel Ramos</span>
    <span class="brand-role">Software Developer Intern</span>
  </a>

  <button
    type="button"
    class="control menu-button"
    aria-expanded="false"
    aria-controls="menu-principal"
    data-menu-button
  >
    {t.menu}
  </button>

  <nav aria-label={t.navLabel} class="rail-nav" id="menu-principal">
    {items.map((item) => (
      <a href={item.href} aria-current={selectedItem === item.id ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
  </nav>

  <Controls lang={lang} alternates={alternates} />
</header>
