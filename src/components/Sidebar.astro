---
import Controls from './Controls.astro';
import { routes, ui, type Lang } from '../i18n/ui';

interface Props {
  selectedItem?: string;
  lang?: Lang;
  alternates?: Partial<Record<Lang, string>>;
}

const { selectedItem, lang = 'pt', alternates } = Astro.props;
const t = ui[lang];

// Ícones no estilo Lucide (licença ISC). Sempre acompanham o texto e ficam escondidos de leitores de tela.
const icons = {
  home: '<path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>',
  projetos: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  experiencia: '<path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/><rect width="20" height="14" x="2" y="6" rx="2"/>',
  formacao: '<path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/>',
  blog: '<path d="M15 18h-5"/><path d="M18 14h-8"/><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-4 0v-9a2 2 0 0 1 2-2h2"/><rect width="8" height="4" x="10" y="6" rx="1"/>',
};

const items = [
  { id: 'home', href: routes.home[lang], label: t.nav.home },
  { id: 'projetos', href: routes.projects[lang], label: t.nav.projects },
  { id: 'experiencia', href: routes.experience[lang], label: t.nav.experience },
  { id: 'formacao', href: routes.education[lang], label: t.nav.education },
  { id: 'blog', href: routes.blog[lang], label: t.nav.blog },
];
---

<header class="rail" data-rail>
  <a href={routes.home[lang]} class="brand">
    <span class="brand-name">Gabriel Ramos</span>
    <span class="brand-role">Software Developer Intern</span>
  </a>

  <button
    type="button"
    class="control menu-button"
    aria-expanded="false"
    aria-controls="menu-principal"
    data-menu-button
  >
    {t.menu}
  </button>

  <nav aria-label={t.navLabel} class="rail-nav" id="menu-principal">
    {items.map((item) => (
      <a href={item.href} aria-current={selectedItem === item.id ? 'page' : undefined}>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false" set:html={icons[item.id]} />
        <span>{item.label}</span>
      </a>
    ))}
  </nav>

  <Controls lang={lang} alternates={alternates} />
</header>
