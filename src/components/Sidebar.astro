---
const { selectedItem } = Astro.props;

const items = [
  { id: 'home', href: '/', icon: '/assets/home.svg', label: 'Home' },
  { id: 'projetos', href: '/projetos', icon: '/assets/code.svg', label: 'Projetos' },
  { id: 'formacao', href: '/formacao', icon: '/assets/graduation.svg', label: 'Formação' },
  { id: 'experiencia', href: '/experiencia', icon: '/assets/briefcase.svg', label: 'Experiência' },
  { id: 'blog', href: '/blog', icon: '/assets/blog.svg', label: 'Blog' },
];
---

<aside
  data-animation="default"
  data-collapse="medium"
  data-duration="400"
  data-easing="ease"
  data-easing2="ease"
  role="banner"
  class="sidebar w-nav"
>
  <div class="nav-content">
    <a href="/" class="w-nav-brand" aria-label="home">
      <div class="niv-data">
        <img
          src="/assets/gabriel.jpg"
          loading="eager"
          alt="Foto de Gabriel Ramos" width="48" height="48"
          class="niv-image"
        />
        <div>
          <div class="label-white">Gabriel Ramos</div>
          <div class="label-gray">Software Developer Intern</div>
        </div>
      </div>
    </a>

    <nav aria-label="Principal" class="w-nav-menu" id="menu-principal">
      {items.map((item) => (
        <a
          href={item.href}
          class={`nav-link-container w-inline-block ${selectedItem === item.id ? 'w--current' : ''}`}
          aria-current={selectedItem === item.id ? 'page' : undefined}
        >
          <img src={item.icon} loading="eager" alt="" class="nav-link-image" />
          <div>{item.label}</div>
        </a>
      ))}
    </nav>

    <button
      type="button"
      class="navbar-icon-button w-nav-button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="menu-principal"
    >
      <img src="/assets/menu.svg" loading="eager" alt="" class="navbar-icon" />
    </button>
  </div>

  <script>
    import { setupNav } from '../scripts/nav.js';
    
    let cleanup;
    document.addEventListener('astro:page-load', () => {
      if (cleanup) cleanup();
      cleanup = setupNav();
    });

    document.addEventListener('astro:before-swap', () => {
      if (cleanup) cleanup();
    });
  </script>
</aside>
