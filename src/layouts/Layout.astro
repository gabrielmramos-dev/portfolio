---
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import Controls from '../components/Controls.astro';
import '@fontsource-variable/schibsted-grotesk';
import '@fontsource-variable/newsreader';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { htmlLang, ogLocale, ui, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  selectedItem?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  lang?: Lang;
  /** Idioma do conteúdo, quando difere do idioma da interface (ex.: posts em português dentro da interface em inglês). */
  contentLang?: Lang;
  /** Caminho canônico, quando a página repete o conteúdo de outra. */
  canonicalPath?: string;
  /** `false` quando as páginas alternativas não são traduções uma da outra. */
  hreflang?: boolean;
  /** Caminho equivalente em cada idioma, quando a página existe nos dois. */
  alternates?: Partial<Record<Lang, string>>;
}

const {
  title,
  lang = 'pt',
  contentLang = lang,
  canonicalPath,
  hreflang = true,
  description = ui[lang].siteDescription,
  selectedItem = '',
  image = '/assets/og-image.png',
  imageAlt = 'Gabriel Ramos — Software Developer Intern. Backend .NET/TypeScript',
  type = 'website',
  noindex = false,
  alternates,
} = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const hreflangs = alternates && hreflang
  ? (Object.entries(alternates) as [Lang, string][]).map(([l, path]) => ({
      hreflang: htmlLang[l],
      href: new URL(path, Astro.site),
    }))
  : [];
const defaultAlternate = alternates?.pt && hreflang ? new URL(alternates.pt, Astro.site) : null;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate} />}
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Gabriel Ramos" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="alternate" type="application/rss+xml" title="Blog | Gabriel Ramos" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      (function () {
        var theme;
        try {
          theme = localStorage.getItem('theme');
        } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        document.documentElement.dataset.theme = theme;
        document.addEventListener('astro:before-swap', function (event) {
          event.newDocument.documentElement.dataset.theme = document.documentElement.dataset.theme;
        });
      })();
    </script>
    <link rel="icon" href="/assets/favicon-32x32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/favicon-32x32.png" />
    <ClientRouter />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">{ui[lang].skip}</a>
    <div class="shell">
      <Sidebar selectedItem={selectedItem} lang={lang} alternates={alternates} />
      <div class="page" id="conteudo">
        <main class="container" lang={contentLang !== lang ? htmlLang[contentLang] : undefined}>
          <slot />
        </main>
        <footer class="site-footer">
          <div class="site-footer-inner">
            <span>© {new Date().getFullYear()} Gabriel Ramos</span>
            <span class="site-footer-links">
              <a href="https://github.com/gabrielmramos-dev" target="_blank" rel="noopener noreferrer">GitHub</a>
              <a href="https://linkedin.com/in/ongabrielramos" target="_blank" rel="noopener noreferrer">LinkedIn</a>
              <a href="mailto:gabrieldotech@gmail.com">{ui[lang].footerContact}</a>
            </span>
          </div>
          <Controls lang={lang} alternates={alternates} class="page-controls" />
        </footer>
      </div>
    </div>
    <script>
      import '../scripts/theme.js';
      import { setupNav } from '../scripts/nav.js';

      let cleanup;
      document.addEventListener('astro:page-load', () => {
        if (cleanup) cleanup();
        cleanup = setupNav();
      });
    </script>
  </body>
</html>
