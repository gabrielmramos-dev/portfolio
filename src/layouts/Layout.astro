---
import { ClientRouter } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import { htmlLang, ogLocale, ui, type Lang } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  selectedItem?: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  lang?: Lang;
  /** Caminho equivalente em cada idioma, quando a página existe nos dois. */
  alternates?: Partial<Record<Lang, string>>;
}

const {
  title,
  lang = 'pt',
  description = ui[lang].siteDescription,
  selectedItem = '',
  image = '/assets/og-image.png',
  imageAlt = 'Gabriel Ramos — Software Developer Intern. Backend .NET/TypeScript',
  type = 'website',
  noindex = false,
  alternates,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const hreflangs = alternates
  ? (Object.entries(alternates) as [Lang, string][]).map(([l, path]) => ({
      hreflang: htmlLang[l],
      href: new URL(path, Astro.site),
    }))
  : [];
const defaultAlternate = alternates?.pt ? new URL(alternates.pt, Astro.site) : null;
---

<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {hreflangs.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate} />}
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="Gabriel Ramos" />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="alternate" type="application/rss+xml" title="Blog | Gabriel Ramos" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@300;400;500;600&display=swap" />
    </noscript>
    <link rel="stylesheet" href="/assets/styles.css" />
    <link rel="icon" href="/assets/favicon-32x32.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/favicon-32x32.png" />
    <ClientRouter />
  </head>
  <body>
    <a href="#conteudo" class="skip-link">{ui[lang].skip}</a>
    <div class="content">
      <Sidebar selectedItem={selectedItem} lang={lang} alternates={alternates} />
      <div class="main" id="conteudo">
        <div class="container">
          <slot />
        </div>
        <footer class="site-footer">
          <span>© {new Date().getFullYear()} Gabriel Ramos</span>
          <span class="site-footer-links">
            <a href="https://github.com/gabrielmramos-dev" target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="https://linkedin.com/in/ongabrielramos" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            <a href="mailto:gabrieldotech@gmail.com">{ui[lang].footerContact}</a>
          </span>
        </footer>
      </div>
    </div>
  </body>
</html>
