---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 - Página não encontrada | Gabriel Ramos" noindex>
  <h1>Página não encontrada</h1>
  <p class="lead-text">O endereço não existe ou foi movido. Os projetos e o blog estão a um clique.</p>
  <div class="actions">
    <a href="/projetos/" class="button button-primary">Ver os projetos</a>
    <a href="/blog/" class="button">Ver o blog</a>
    <a href="/" class="button">Voltar para o início</a>
  </div>
</Layout>
