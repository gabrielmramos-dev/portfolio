---
import Layout from '../layouts/Layout.astro';
import BackLink from '../components/BackLink.astro';
import BlogCard from '../components/BlogCard.astro';
import { getAllPosts } from '../lib/posts';

const posts = await getAllPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
---

<Layout
  title="Blog | Gabriel Ramos"
  description="Artigos, reflexões e aprendizados sobre tecnologia, desenvolvimento e o que mais eu estiver estudando."
  selectedItem="blog"
>
  <BackLink />
  <h1>Blog</h1>
  <p class="lead-text">
    Artigos, reflexões e aprendizados sobre tecnologia, desenvolvimento e o que mais eu estiver estudando.
  </p>

  {posts.length === 0 ? (
    <p class="section-note">Nenhum post publicado ainda.</p>
  ) : (
    <div class="posts">
      {tags.length > 1 && (
        <div class="filters" role="group" aria-label="Filtrar por tag">
          <button type="button" class="control" data-tag="" aria-pressed="true">Todos</button>
          {tags.map((tag) => (
            <button type="button" class="control" data-tag={tag} aria-pressed="false">{tag}</button>
          ))}
        </div>
      )}
      <ul class="post-list" role="list">
        {posts.map((post) => (
          <BlogCard post={post} />
        ))}
      </ul>
    </div>
  )}
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filters .control');
    const cards = document.querySelectorAll<HTMLElement>('.post-row');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const tag = button.dataset.tag ?? '';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        cards.forEach((card) => {
          const cardTags = (card.dataset.tags ?? '').split('|');
          card.hidden = tag !== '' && !cardTags.includes(tag);
        });
      });
    });
  });
</script>
