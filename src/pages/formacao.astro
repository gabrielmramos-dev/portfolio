---
import Layout from "../layouts/Layout.astro";
import BackLink from "../components/BackLink.astro";
---

<Layout
  title="Formação Acadêmica | Gabriel Ramos"
  description="Análise e Desenvolvimento de Sistemas na Universidade Braz Cubas (3º semestre)."
  selectedItem="formacao"
>
  <BackLink />
  <div class="content-container">
    <h1>Formação Acadêmica</h1>
    <section class="items-container">
      <div class="resouce-items">
        <div class="single-item">
          <h3>Análise e Desenvolvimento de Sistemas</h3>
          <p class="meta-line">
            <strong>Universidade Braz Cubas</strong> — Cursando, 3º semestre
          </p>
          <div class="project-desc w-richtext">
            <p>Formação com foco em fundamentos de desenvolvimento de software, lógica de programação e sistemas computacionais, aliando teoria à prática por meio de projetos.</p>
          </div>
          <div class="mini-label-white">Principais Disciplinas</div>
          <div class="chips-container">
            <div class="single-chip">Programação Web</div>
            <div class="single-chip">Técnicas e Desenvolvimento de Algoritmos</div>
            <div class="single-chip">Programação Orientada a Objetos</div>
            <div class="single-chip">Fundamentos de Estruturas de Dados</div>
            <div class="single-chip">Banco de Dados</div>
            <div class="single-chip">Sistemas Operacionais</div>
            <div class="single-chip">Engenharia de Software</div>
            <div class="single-chip">Sistemas Cliente/Servidor</div>
            <div class="single-chip">Computação em Nuvem</div>
            <div class="single-chip">Análise e Projeto de Sistemas I</div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
