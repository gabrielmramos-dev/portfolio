---
import Layout from '../layouts/Layout.astro';
import BackLink from '../components/BackLink.astro';
import BlogCard from '../components/BlogCard.astro';
import { getAllPosts } from '../lib/posts';
import { routes, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const posts = await getAllPosts();
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();

const copy = {
  pt: {
    title: 'Blog | Gabriel Ramos',
    description: 'Artigos, reflexões e aprendizados sobre tecnologia, desenvolvimento e o que mais eu estiver estudando.',
    lead: 'Artigos, reflexões e aprendizados sobre tecnologia, desenvolvimento e o que mais eu estiver estudando.',
    empty: 'Nenhum post publicado ainda.',
    filter: 'Filtrar por tag',
    all: 'Todos',
  },
  en: {
    title: 'Blog | Gabriel Ramos',
    description: 'Articles and notes on technology and software development. The posts are written in Portuguese.',
    lead: 'Articles and notes on technology and software development. The posts are written in Portuguese.',
    empty: 'No posts published yet.',
    filter: 'Filter by tag',
    all: 'All',
  },
}[lang];
---

<Layout
  title={copy.title}
  description={copy.description}
  selectedItem="blog"
  lang={lang}
  contentLang="pt"
  alternates={{ pt: routes.blog.pt, en: routes.blog.en }}
  hreflang={false}
  canonicalPath={routes.blog.pt}
>
  <BackLink href={routes.home[lang]} label={ui[lang].back} />
  <h1>Blog</h1>
  <p class="lead-text">{copy.lead}</p>

  {posts.length === 0 ? (
    <p class="section-note">{copy.empty}</p>
  ) : (
    <div class="posts">
      {tags.length > 1 && (
        <div class="filters" role="group" aria-label={copy.filter}>
          <button type="button" class="control" data-tag="" aria-pressed="true">{copy.all}</button>
          {tags.map((tag) => (
            <button type="button" class="control" data-tag={tag} aria-pressed="false">{tag}</button>
          ))}
        </div>
      )}
      <ul class="post-list" role="list" lang="pt-BR">
        {posts.map((post) => (
          <BlogCard post={post} lang={lang} />
        ))}
      </ul>
    </div>
  )}
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const buttons = document.querySelectorAll<HTMLButtonElement>('.filters .control');
    const cards = document.querySelectorAll<HTMLElement>('.post-row');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const tag = button.dataset.tag ?? '';
        buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
        cards.forEach((card) => {
          const cardTags = (card.dataset.tags ?? '').split('|');
          card.hidden = tag !== '' && !cardTags.includes(tag);
        });
      });
    });
  });
</script>
