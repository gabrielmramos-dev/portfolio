---
import Layout from '../layouts/Layout.astro';
import BackLink from '../components/BackLink.astro';
import { education, semesterLabel } from '../data/education';
import { routes, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const semester = semesterLabel(lang);

const copy = {
  pt: {
    title: 'Formação Acadêmica | Gabriel Ramos',
    heading: 'Formação Acadêmica',
    summary:
      'Formação com foco em fundamentos de desenvolvimento de software, lógica de programação e sistemas computacionais, aliando teoria à prática por meio de projetos.',
    subjectsLabel: 'Principais disciplinas',
    note: 'Agrupadas por tema. As marcadas como "Cursando" são do período atual.',
  },
  en: {
    title: 'Education | Gabriel Ramos',
    heading: 'Education',
    summary:
      'A degree focused on software development fundamentals, programming logic and computer systems, combining theory and practice through projects.',
    subjectsLabel: 'Main subjects',
    note: 'Grouped by theme. Those marked "In progress" belong to the current term.',
  },
}[lang];

const description =
  lang === 'pt'
    ? `${education.course.pt} na ${education.institution.pt} (${semester}).`
    : `${education.course.en} at ${education.institution.en} (${semester}).`;
---

<Layout
  title={copy.title}
  description={description}
  selectedItem="formacao"
  lang={lang}
  alternates={{ pt: routes.education.pt, en: routes.education.en }}
>
  <BackLink href={routes.home[lang]} label={ui[lang].back} />
  <h1>{copy.heading}</h1>
  <article class="entry">
    <h2>{education.course[lang]}</h2>
    <p class="entry-meta">
      <strong>{education.institution[lang]}</strong> · {education.status[lang]}, {semester}
    </p>
    <p>{copy.summary}</p>
    <h3 class="label">{copy.subjectsLabel}</h3>
    <p class="section-note">{copy.note}</p>
    {education.groups.map((group) => (
      <section class="subject-group">
        <h4>{group.title[lang]}</h4>
        <ul>
          {group.subjects.map((subject) => (
            <li>
              {subject.name[lang]}
              {subject.optional && <span class="subject-note"> ({education.optionalLabel[lang]})</span>}
              {subject.term === education.currentTerm && <span class="badge">{education.currentLabel[lang]}</span>}
            </li>
          ))}
        </ul>
      </section>
    ))}
  </article>
</Layout>
