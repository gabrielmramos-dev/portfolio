---
import Layout from '../layouts/Layout.astro';
import BackLink from '../components/BackLink.astro';
import { routes, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Fonte: o próprio Gabriel (texto do LinkedIn, conferido por ele). Termos em geral, sem nomes internos
// de projeto, IDs de nuvem ou códigos de tarefa.
const copy = {
  pt: {
    title: 'Experiência Profissional | Gabriel Ramos',
    description:
      'Experiência de Gabriel Ramos: Software Developer Intern na PRODAM (C#/.NET, IA generativa com RAG e streaming, MongoDB, BigQuery) e instrutor de informática e desenvolvedor na Microlins.',
    heading: 'Experiência Profissional',
    techLabel: 'Tecnologias',
    prodam: {
      role: 'Software Developer Intern',
      place: 'PRODAM — Prefeitura de São Paulo',
      period: 'março de 2026 — momento atual · São Paulo, híbrido',
      summary:
        'Desenvolvo sistemas digitais para a Prefeitura de São Paulo, a maior cidade do Brasil, em uma plataforma que gera artefatos de software com IA generativa (épicos, features, user stories, planos de teste e massa de dados), em um squad ágil com desenvolvedores, arquitetos, QA, analistas, PO e UX/UI.',
      groups: [
        {
          label: 'Responsabilidades',
          items: [
            'Desenvolvo funcionalidades de ponta a ponta em C#/.NET com Clean Architecture, do endpoint à tela.',
            'Integro modelos Gemini (Vertex AI) e Claude em um pipeline com RAG e respostas em streaming (SSE).',
            'Mantenho prompts dinâmicos e parâmetros dos modelos em MongoDB, com apoio de Redis e BigQuery.',
            'Uso agentes de IA com MCP para acelerar o desenvolvimento.',
            'Escrevo testes automatizados com xUnit e testes de UI automatizados com o MCP do Playwright.',
          ],
        },
        {
          label: 'Entregas',
          items: [
            'Mais de 70 itens entregues em cerca de 6 meses.',
            'Construí a gestão de prompts e parâmetros dos modelos (MongoDB) e migrei, funcionalidade por funcionalidade, os prompts que estavam no código para um cadastro em tela de administração, o que permite ajustar a IA sem novo deploy.',
            'Instrumentei no BigQuery o modelo, a temperatura e o nível de pensamento de cada geração, dando rastreabilidade às respostas.',
            'Estabilizei o streaming SSE com Gemini, eliminando repetições e buffering nas respostas.',
            'Entreguei de ponta a ponta um formulário longo de levantamento de negócio: salvamento por campo, cálculo de completude e interface alinhada ao protótipo.',
            'Tornei a integração com o Azure DevOps (Wiki) resistente a falhas de rede e SSL, com novas tentativas automáticas e mensagens claras para permissão negada, pasta inexistente e Wiki vazia.',
            'Criei uma nova tela inicial que mostra o projeto por fases e etapas, e um botão para gerar um novo artefato a partir de cada etapa, com testes unitários.',
          ],
        },
      ],
      tech: ['C#/.NET 8', 'ASP.NET Core MVC', 'Clean Architecture', 'Gemini e Claude (Vertex AI)', 'RAG', 'MongoDB', 'Redis', 'BigQuery', 'Azure DevOps', 'MCP', 'xUnit', 'Playwright MCP'],
    },
    microlins: {
      role: 'Desenvolvedor Back-end | Instrutor de TI pleno',
      place: 'Microlins',
      period: 'outubro de 2024 — janeiro de 2026 · São Paulo',
      summary:
        'Desenvolvimento e ensino de tecnologia em uma das maiores redes de educação profissional do Brasil. Antes, de novembro de 2023 a outubro de 2024, atuei como Instrutor de TI júnior na mesma rede.',
      groups: [
        {
          label: 'Entregas',
          items: [
            'Implementei uma arquitetura RAG integrada à Groq API para gerar materiais didáticos de forma automatizada, com padronização e escalabilidade.',
            'Desenvolvi automações em Node.js e bots de mensagens (WhatsApp e Telegram), reduzindo o retrabalho administrativo da unidade.',
            'Construí dashboards e um sistema de gamificação fullstack com SQL para analisar métricas de engajamento.',
            'Mentoreei mais de 200 alunos em lógica de programação, arquitetura de sistemas e tecnologias modernas.',
          ],
        },
      ],
      tech: ['Node.js', 'SQL', 'Groq API', 'RAG', 'Automação'],
    },
  },
  en: {
    title: 'Professional Experience | Gabriel Ramos',
    description:
      'Gabriel Ramos’s experience: Software Developer Intern at PRODAM (C#/.NET, generative AI with RAG and streaming, MongoDB, BigQuery) and IT instructor and developer at Microlins.',
    heading: 'Professional Experience',
    techLabel: 'Technologies',
    prodam: {
      role: 'Software Developer Intern',
      place: 'PRODAM — São Paulo City Hall',
      period: 'March 2026 — present · São Paulo, hybrid',
      summary:
        'I build digital systems for the City of São Paulo, Brazil’s largest city, on a platform that generates software artifacts with generative AI (epics, features, user stories, test plans and test data), in an agile squad with developers, architects, QA, analysts, a PO and UX/UI.',
      groups: [
        {
          label: 'Responsibilities',
          items: [
            'I build features end to end in C#/.NET with Clean Architecture, from the endpoint to the screen.',
            'I integrate Gemini (Vertex AI) and Claude models into a pipeline with RAG and streamed responses (SSE).',
            'I maintain dynamic prompts and model parameters in MongoDB, backed by Redis and BigQuery.',
            'I use AI agents with MCP to speed up development.',
            'I write automated tests with xUnit and automated UI tests with the Playwright MCP.',
          ],
        },
        {
          label: 'Deliveries',
          items: [
            'More than 70 items delivered in about 6 months.',
            'Built prompt and model-parameter management (MongoDB) and migrated, feature by feature, the prompts that lived in code into an admin screen, so the team can tune the AI without a new deploy.',
            'Instrumented BigQuery with the model, temperature and thinking level of every generation, making answers traceable.',
            'Stabilized SSE streaming with Gemini, removing repeated text and buffering in responses.',
            'Delivered a long business-discovery form end to end: per-field saving, completeness calculation and a UI aligned with the prototype.',
            'Made the Azure DevOps (Wiki) integration resilient to network and SSL failures, with automatic retries and clear messages for denied permission, a missing folder and an empty Wiki.',
            'Built a new home screen that shows the project by phases and steps, and a button to generate a new artifact from each step, with unit tests.',
          ],
        },
      ],
      tech: ['C#/.NET 8', 'ASP.NET Core MVC', 'Clean Architecture', 'Gemini and Claude (Vertex AI)', 'RAG', 'MongoDB', 'Redis', 'BigQuery', 'Azure DevOps', 'MCP', 'xUnit', 'Playwright MCP'],
    },
    microlins: {
      role: 'Back-end Developer | IT Instructor (mid-level)',
      place: 'Microlins',
      period: 'October 2024 — January 2026 · São Paulo',
      summary:
        'Software development and technology teaching at one of Brazil’s largest professional education networks. Before that, from November 2023 to October 2024, I worked as a junior IT Instructor in the same network.',
      groups: [
        {
          label: 'Deliveries',
          items: [
            'Implemented a RAG architecture integrated with the Groq API to generate teaching materials automatically, with standardization and scalability.',
            'Built Node.js automations and messaging bots (WhatsApp and Telegram), reducing the unit’s administrative rework.',
            'Built dashboards and a fullstack gamification system with SQL to analyze engagement metrics.',
            'Mentored more than 200 students in programming logic, systems architecture and modern technologies.',
          ],
        },
      ],
      tech: ['Node.js', 'SQL', 'Groq API', 'RAG', 'Automation'],
    },
  },
}[lang];

const entries = [copy.prodam, copy.microlins];
---

<Layout
  title={copy.title}
  description={copy.description}
  selectedItem="experiencia"
  lang={lang}
  alternates={{ pt: routes.experience.pt, en: routes.experience.en }}
>
  <BackLink href={routes.home[lang]} label={ui[lang].back} />
  <h1>{copy.heading}</h1>
  <div class="entries">
    {entries.map((entry) => (
      <article class="entry">
        <h2>{entry.role}</h2>
        <p class="entry-meta"><strong>{entry.place}</strong> · {entry.period}</p>
        <p>{entry.summary}</p>
        {entry.groups.map((group) => (
          <>
            <h3 class="label">{group.label}</h3>
            <ul>{group.items.map((item) => <li>{item}</li>)}</ul>
          </>
        ))}
        <p class="case-tech"><strong>{copy.techLabel}:</strong> {entry.tech.join(', ')}</p>
      </article>
    ))}
  </div>
  {/*
    TODO(gabriel): as entregas novas da PRODAM estão em termos gerais (sem nome do sistema, códigos de tarefa ou nomes internos de componentes). Confirme com a PRODAM que descrições assim podem ser públicas.
  */}
</Layout>
