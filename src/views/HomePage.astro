---
import Layout from '../layouts/Layout.astro';
import ProjectActivity from '../components/ProjectActivity.astro';
import { getAllPosts, readingTime } from '../lib/posts';
import ProjectFigure from '../components/ProjectFigure.astro';
import { visibleProjects } from '../data/projects';
import Email from '../components/Email.astro';
import { education } from '../data/education';
import { site } from '../data/site';
import { person, website } from '../lib/jsonld';
import { routes, ui, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const origin = Astro.site!.origin;

const newTab = ui[lang].newTab;

// Currículo: no inglês, usa o PDF em inglês quando existir; senão, o PDF em português, avisando.
const resumeHref = lang === 'en' && site.resume.en ? site.resume.en : site.resume.pt;
const resumeLabel = lang === 'en' ? (site.resume.en ? 'Résumé' : 'Résumé (PT)') : 'Currículo';
const [latestPost] = await getAllPosts();
const postDate = latestPost.data.date.toLocaleDateString(lang === 'pt' ? 'pt-BR' : 'en-US', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const postHref = `${routes.blog[lang]}${latestPost.id}/`;

const copy = {
  pt: {
    title: 'Gabriel Ramos | Desenvolvedor .NET e IA aplicada',
    greeting: 'Olá, eu sou o Gabriel.',
    // Posicionamento A (em uso). B, full-stack, fica pronta: 'Desenvolvedor full-stack · .NET, TypeScript e IA aplicada'.
    positioning: 'Desenvolvedor .NET · APIs, dados abertos e IA aplicada',
    techLine: 'C#/.NET · TypeScript · ASP.NET Core MVC · GCP (Vertex AI, BigQuery) · RAG e embeddings · xUnit',
    lead: 'Software Developer Intern na PRODAM — empresa de tecnologia da Prefeitura de São Paulo. Trabalho com C#/.NET e IA generativa (Gemini e Claude, via Vertex AI) em um squad ágil, desenvolvendo serviços digitais para a cidade. Fora do trabalho, construo projetos próprios de back-end, APIs e dados abertos.',
    contact: 'Falar comigo',
    seeProjects: 'Ver projetos',
    projects: 'Projetos',
    caseStudy: 'Ler o estudo de caso',
    about: 'Sobre',
    latest: 'Último post',
    minRead: 'min de leitura',
    allPosts: 'Ver todos os posts',
    ptNote: '',
  },
  en: {
    title: 'Gabriel Ramos | .NET Developer and Applied AI',
    greeting: 'Hi, I’m Gabriel.',
    // Positioning A (in use). B, full-stack, is ready: 'Full-stack developer · .NET, TypeScript and applied AI'.
    positioning: '.NET developer · APIs, open data and applied AI',
    techLine: 'C#/.NET · TypeScript · ASP.NET Core MVC · GCP (Vertex AI, BigQuery) · RAG and embeddings · xUnit',
    lead: 'Software Developer Intern at PRODAM, the technology company of the São Paulo City Hall. I work with C#/.NET and generative AI (Gemini and Claude, via Vertex AI) in an agile squad, building digital services for the city. Outside work, I build my own backend, API and open-data projects.',
    contact: 'Get in touch',
    seeProjects: 'See projects',
    projects: 'Projects',
    caseStudy: 'Read the case study',
    about: 'About',
    latest: 'Latest post',
    minRead: 'min read',
    allPosts: 'See all posts',
    ptNote: 'The post is written in Portuguese.',
  },
}[lang];
---

<Layout
  title={copy.title}
  selectedItem="home"
  lang={lang}
  alternates={{ pt: routes.home.pt, en: routes.home.en }}
  jsonLd={[person(origin), website(origin)]}
>
  <section class="hero">
    <h1>{copy.greeting}<br />Software Developer Intern.</h1>
    <p class="positioning">{copy.positioning}</p>
    <p class="tech-line">{copy.techLine}</p>
    <div class="actions">
      <a href="#projetos" class="button button-primary">{copy.seeProjects}</a>
      <Email class="button" label={copy.contact} />
    </div>
    <p class="hero-links">
      <a href={site.social.github.url} target="_blank" rel="noopener noreferrer">{site.social.github.label}<span class="sr-only">{newTab}</span></a>
      <a href={site.social.linkedin.url} target="_blank" rel="noopener noreferrer">{site.social.linkedin.label}<span class="sr-only">{newTab}</span></a>
      <a href={resumeHref} download>{resumeLabel}</a>
    </p>
  </section>

  <section aria-labelledby="projetos-titulo" id="projetos" class="gallery">
    <h2 id="projetos-titulo" class="section-title">{copy.projects}</h2>
    <div class="gallery-items">
    {visibleProjects.map((p) => (
      <article class="gallery-item" aria-labelledby={`g-${p.id}`}>
        <div class="case-head">
          <div class="case-title">
            <h3 id={`g-${p.id}`} class="case-heading">{p.title}</h3>
            {p.badge && <span class:list={['badge', p.badgeTone === 'ok' && 'badge-ok']}>{p.badge[lang]}</span>}
          </div>
          <a href={`${routes.projects[lang]}#${p.id}`}>{copy.caseStudy}<span class="sr-only">: {p.title}</span></a>
        </div>
        <p class="case-summary">{p.summary[lang]}</p>
        <ProjectFigure project={p} lang={lang} />
        <p class="case-tech">{p.tech.slice(0, 5).join(', ')}</p>
      </article>
    ))}
    </div>
  </section>

  <ProjectActivity lang={lang} />

  <section class="latest-post" aria-labelledby="ultimo-post">
    <div class="section-head">
      <h2 id="ultimo-post">{copy.latest}</h2>
      <a href={routes.blog[lang]}>{copy.allPosts}</a>
    </div>
    <article lang="pt-BR">
      <h3><a href={postHref} class="post-title-link">{latestPost.data.title}</a></h3>
      <p class="post-desc">{latestPost.data.description}</p>
      <p class="post-meta">
        <time datetime={latestPost.data.date.toISOString()}>{postDate}</time> · {readingTime(latestPost)} {copy.minRead}
      </p>
    </article>
    {copy.ptNote && <p class="section-note">{copy.ptNote}</p>}
  </section>

  <section class="about" aria-labelledby="sobre">
    <h2 id="sobre">{copy.about}</h2>
    <p class="subtitle">{education.course[lang]} · {education.institution[lang]}</p>
    <p class="lead">{copy.lead}</p>
  </section>
</Layout>
