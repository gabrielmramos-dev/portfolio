---
import Layout from '../layouts/Layout.astro';
import BackLink from '../components/BackLink.astro';
import Project from '../components/Project.astro';
import { visibleProjects } from '../data/projects';
import { breadcrumbs, homeLabel } from '../lib/jsonld';
import { routes, ui, type Lang } from '../i18n/ui';
import { makeAbbr, terms } from '../lib/abbr';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const origin = Astro.site!.origin;
// As siglas da lista são colhidas aqui, antes de renderizar: os componentes filhos só rodam depois desta página montar a lista.
const used = new Set<string>();
for (const project of visibleProjects) {
  const collect = makeAbbr(lang, used);
  [project.summary[lang], project.problem[lang], project.result[lang], ...project.decisions[lang], ...project.limits[lang]].forEach(collect);
}

const copy = {
  pt: {
    title: 'Projetos | Gabriel Ramos',
    description:
      'Projetos de Gabriel Ramos como estudos de caso: problema, decisões técnicas, limites e resultado. Dados abertos com MCP, app acessível e geoprocessamento.',
    heading: 'Projetos',
    glossary: 'Termos usados nesta página',
  },
  en: {
    title: 'Projects | Gabriel Ramos',
    description:
      'Gabriel Ramos’s projects as case studies: problem, technical decisions, limits and result. Open data with MCP, an accessible app and geospatial.',
    heading: 'Projects',
    glossary: 'Terms used on this page',
  },
}[lang];
---

<Layout
  title={copy.title}
  description={copy.description}
  selectedItem="projetos"
  lang={lang}
  alternates={{ pt: routes.projects.pt, en: routes.projects.en }}
  jsonLd={[breadcrumbs([{ name: homeLabel(lang), url: origin + routes.home[lang] }, { name: copy.heading, url: origin + routes.projects[lang] }])]}
>
  <BackLink href={routes.home[lang]} label={ui[lang].back} />
  <h1>{copy.heading}</h1>
  <div class="cases">
    {visibleProjects.map((project) => <Project project={project} lang={lang} />)}
  </div>
  <section class="glossary" aria-labelledby="glossario">
    <h2 id="glossario">{copy.glossary}</h2>
    <dl>
      {[...used].sort().map((key) => (
        <>
          <dt>{key}</dt>
          <dd>{terms[key][lang]}</dd>
        </>
      ))}
    </dl>
  </section>
</Layout>
